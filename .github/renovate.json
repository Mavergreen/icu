{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Mavergreen/shipyard"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "ICU release tags are release-<ver> since 78.1; prerelease, icu4x and cldr tags never match.",
      "managerFilePatterns": ["/^UPSTREAM_VERSION$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "unicode-org/icu",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^release-(?<version>\\d+\\.\\d+(?:\\.\\d+)?)$"
    },
    {
      "customType": "regex",
      "description": "The clang22 toolchain pin: a Mavergreen/clang-22 release tag, bare.",
      "managerFilePatterns": ["/^components/clang22/version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "Mavergreen/clang-22",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-mavericks\\.(?<build>\\d+)$"
    }
  ]
}
